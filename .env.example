MOVIES_DIR=media/Movies
DATABASE_PATH=data/library.sqlite3
HOST=0.0.0.0
PORT=8080
# PUBLIC_BASE_URL=http://your-server:8080

# Vizio / Google Cast receiver (fixed LAN IPv4 address)
CAST_HOST=
CAST_NAME=Living Room

# Playback compatibility: automatic codec/container decisions; original files stay untouched
ROKU_AUDIO_MODE=auto
ROKU_CACHE_DIR=data/roku-cache
ROKU_CACHE_MAX_GB=50
ROKU_PREPARE_TIMEOUT=3600
# Optional absolute tool paths; otherwise PATH or installed static-ffmpeg is used.
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe

# Automatically scan for new files and fetch missing public-source artwork.
AUTO_ARTWORK=true
AUTO_LIBRARY_SCAN_SECONDS=300
ARTWORK_RETRY_SECONDS=86400

# Optional: h264_nvenc after verifying FFmpeg/NVIDIA support; libx264 is default.
ROKU_VIDEO_ENCODER=libx264

# Subtitle assets are served locally. Downloads need an API consumer key.
AUTO_SUBTITLES=true
SUBTITLE_LANGUAGES=en
SUBTITLE_PREFER_SDH=false
SUBTITLE_DAILY_DOWNLOAD_LIMIT=5
OPENSUBTITLES_API_KEY=

# Movie end-credits chapter detection (manual markers available in /manage).
AUTO_CREDITS=true

# Analyze movie-ending frames locally when chapters are unavailable.
AUTO_VISUAL_CREDITS=true
CREDIT_ANALYSIS_TIMEOUT=300

# Repeated-audio opening/intro detection
AUTO_INTROS=true
